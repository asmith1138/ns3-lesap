SELECT AVG("delay"), 'Aodv25NormDelay' as title FROM (SELECT "PacketID", Count(*), MAX("SimulationTime") - MIN("SimulationTime") AS delay 
FROM public."AODV25Normal"
WHERE "PacketStatus" in ('Sent', 'Recieved')
GROUP BY "PacketID"
HAVING Count(*) > 1
ORDER BY "delay" desc) AS EndToEndDelay
UNION
SELECT AVG("delay"), 'Aodv25MalDelay' as title FROM (SELECT "PacketID", Count(*), MAX("SimulationTime") - MIN("SimulationTime") AS delay 
FROM public."AODV25Mal"
WHERE "PacketStatus" in ('Sent', 'Recieved')
GROUP BY "PacketID"
HAVING Count(*) > 1
ORDER BY "delay" desc) AS EndToEndDelay
UNION
