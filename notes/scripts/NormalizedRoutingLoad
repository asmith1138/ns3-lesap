WHERE ("PacketStatus" = 'Control-Handled' AND "Reason" = 'LESAPAODV message was handled successfully') 
OR ("PacketStatus" = 'Control-Dropped' AND "Reason" = 'Message Type Unknown')
OR ("PacketStatus" = 'Control-Dropped' AND "Reason" = 'Sender not within Lidar range')), 
DataPacketsAODV50Normal AS (SELECT COUNT(*) AS DataPkts FROM public."AODV50Normal" WHERE "PacketStatus" = 'Recieved')
,
ControlPacketsAODV50Mal AS (SELECT COUNT(*) AS ControlPkts FROM public."AODV50Mal"
WHERE ("PacketStatus" = 'Control-Handled' AND "Reason" = 'LESAPAODV message was handled successfully')
OR ("PacketStatus" = 'Control-Dropped' AND "Reason" = 'Message Type Unknown')
OR ("PacketStatus" = 'Control-Dropped' AND "Reason" = 'Sender not within Lidar range')), 
DataPacketsAODV50Mal AS (SELECT COUNT(*) AS DataPkts FROM public."AODV50Mal" WHERE "PacketStatus" = 'Recieved')
,
