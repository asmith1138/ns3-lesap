SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Aodv25Norm' as title
FROM ControlPacketsAODV25Normal, DataPacketsAODV25Normal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Aodv25Mal' as title
FROM ControlPacketsAODV25Mal, DataPacketsAODV25Mal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Aodv50Norm' as title
FROM ControlPacketsAODV50Normal, DataPacketsAODV50Normal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Aodv50Mal' as title
FROM ControlPacketsAODV50Mal, DataPacketsAODV50Mal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Aodv100Norm' as title
FROM ControlPacketsAODV100Normal, DataPacketsAODV100Normal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Aodv100Mal' as title
FROM ControlPacketsAODV100Mal, DataPacketsAODV100Mal

UNION

SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Lesap25Norm' as title
FROM ControlPacketsLESAP25Normal, DataPacketsLESAP25Normal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Lesap25Mal' as title
FROM ControlPacketsLESAP25Mal, DataPacketsLESAP25Mal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Lesap50Norm' as title
FROM ControlPacketsLESAP50Normal, DataPacketsLESAP50Normal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Lesap50Mal' as title
FROM ControlPacketsLESAP50Mal, DataPacketsLESAP50Mal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Lesap100Norm' as title
FROM ControlPacketsLESAP100Normal, DataPacketsLESAP100Normal
UNION
SELECT *, ControlPkts / DataPkts AS NormalizedRoutingLoad, 'Lesap100Mal' as title
FROM ControlPacketsLESAP100Mal, DataPacketsLESAP100Mal
ORDER BY title;
