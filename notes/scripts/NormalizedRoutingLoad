WITH ControlPacketsAODV25Normal AS (SELECT COUNT(*) AS ControlPkts FROM public."AODV25Normal"
WHERE ("PacketStatus" = 'Control-Handled' AND "Reason" = 'LESAPAODV message was handled successfully') 
OR ("PacketStatus" = 'Control-Dropped' AND "Reason" = 'Message Type Unknown')
OR ("PacketStatus" = 'Control-Dropped' AND "Reason" = 'Sender not within Lidar range')), 
DataPacketsAODV25Normal AS (SELECT COUNT(*) AS DataPkts FROM public."AODV25Normal" WHERE "PacketStatus" = 'Recieved')
,
ControlPacketsAODV25Mal AS (SELECT COUNT(*) AS ControlPkts FROM public."AODV25Mal"
WHERE ("PacketStatus" = 'Control-Handled' AND "Reason" = 'LESAPAODV message was handled successfully')
OR ("PacketStatus" = 'Control-Dropped' AND "Reason" = 'Message Type Unknown')
OR ("PacketStatus" = 'Control-Dropped' AND "Reason" = 'Sender not within Lidar range')), 
DataPacketsAODV25Mal AS (SELECT COUNT(*) AS DataPkts FROM public."AODV25Mal" WHERE "PacketStatus" = 'Recieved')
,
